# https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Optional fallback once Gemini's free quota runs out: https://console.groq.com/keys
GROQ_API_KEY=
# Otari gateway key (otk_... on otari.ai, tk-... self-hosted). Base URL defaults to hosted otari.ai;
# use https://eu.api.otari.ai/api/v1 for an EU account, or http://localhost:8000/api/v1 self-hosted.
OTARI_API_KEY=
OTARI_BASE_URL=
# https://www.reed.co.uk/developers/jobseeker
REED_API_KEY=
# https://developer.adzuna.com
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
# Applications sheet: the id is the long part of its URL. Share the sheet (Editor) with the service
# account's email, and keep its JSON key outside the repo.
APPLICATIONS_SHEET_ID=
GOOGLE_SERVICE_ACCOUNT_FILE=
# Defaults to ./data/jobs.db
JOB_SEARCH_DB=
